rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================== PARTIES ==============================
    //
    // 03/09 : le document de partie n'est plus un livre ouvert pour ses deux joueurs.
    // Avant, un participant pouvait ecrire N'IMPORTE QUEL champ, et n'importe quel
    // connecte creer n'importe quel contenu. Cinq attaques en decoulaient : forger
    // l'abandon de l'adversaire, remplir le plateau de ses propres cartes, enchainer
    // des coups hors de son tour, effacer redUid pour rendre la victime muette, et
    // bourrer le document jusqu'au mebioctet.
    //
    // Desormais chaque ecriture doit se reconnaitre dans UNE intention, et chaque
    // intention a ses cles, ses bornes et ses preconditions :
    //
    //   creation      le createur est l'un des deux camps -- ou un inscrit du tournoi
    //                 dont cette partie est un match -- plateau vide, partie non finie ;
    //   siege Vermeil un tiers n'ecrit que redUid (le sien) et redPseudo ;
    //   preparation   un camp n'ecrit que SES cles, et seulement avant ses Ordres ;
    //   coup          c'est mon tour, la partie a commence, lastMove porte mon camp et
    //                 l'heure du SERVEUR, et le tour repasse en face ;
    //   fin           abandonPar ne designe que MON camp, sauf forfait constate apres
    //                 le vrai delai d'inactivite ;
    //   chat          une liste de 60 messages au plus ;
    //   revanche      mon vote, puis le code une fois les deux votes poses.
    //
    // Ce qui n'apparait dans aucune intention ne bouge plus jamais apres la creation :
    // blueUid, createdAt, status, appariement, classique, tournoiId, matchKey,
    // firstPlayer, les pseudos, les titres et les options de defi. redUid n'a qu'une
    // seule transition permise, null vers celui qui prend le siege.
    //
    // Les fonctions sont declarees ICI, avant le match : aucune regle de ce fichier ne
    // reference une fonction ecrite plus bas. D'ou les noms prefixes partie*, qui
    // evitent toute collision avec les helpers des profils, plus loin.

    function docTournoiPourPartie(t) { return /databases/$(database)/documents/tournaments/$(t); }
    function partieNomBorne(n)  { return n is string && n.size() <= 28; }
    // Une cle de catalogue : un Ordre, un combo, un dos. Courte par nature. Borner le
    // NOMBRE d elements d une liste ne borne pas leur CONTENU : deux chaines d un demi
    // megaoctet tenaient dans une liste de deux. Faute de boucle dans les regles, on
    // deplie -- ces listes sont assez courtes pour que ce soit exact.
    function cleCourte(v) { return v is string && v.size() <= 30; }
    function deuxClesCourtes(l) { return l is list && l.size() == 2 && cleCourte(l[0]) && cleCourte(l[1]); }
    function combosBornes(l) {
      return l is list && l.size() <= 3
        && (l.size() < 1 || cleCourte(l[0]))
        && (l.size() < 2 || cleCourte(l[1]))
        && (l.size() < 3 || cleCourte(l[2]));
    }
    function partieCleBornee(c) { return c is string && c.size() <= 40; }
    function partieEntier(v, mini, maxi) { return v is int && v >= mini && v <= maxi; }

    // Le plateau d'une partie qui commence : vingt cases, toutes vides. Vingt et non
    // CELLS : le plateau standard 4x5 est le seul qui existe en ligne, setBoardSize le
    // remet a chaque entree. hasOnly sur une LISTE dit « aucun element hors de cet
    // ensemble » : avec size(), il interdit de naitre sur un plateau deja joue -- c'est
    // ce qui coupe la partie forgee ou la victime entre pour y perdre quinze trophees.
    function plateauNeuf() {
      return request.resource.data.board is list
        && request.resource.data.board.size() == 20
        && request.resource.data.board.hasOnly([null])
        && request.resource.data.poisonedCells is list
        && request.resource.data.poisonedCells.size() == 20
        && request.resource.data.poisonedCells.hasOnly(['']);
    }

    // Les trente et une cles qu'un document de partie peut porter A SA NAISSANCE, union
    // de QUATRE formes : defi entre amis (les options defi*), appariement (les drapeaux
    // appariement et classique, les trophees, titres et parures), tournoi (tournoiId et
    // matchKey) et revanche (les memes champs d'affichage que l'appariement, echanges).
    // Aucune forme ne les porte toutes ; treize sont communes aux quatre et exigees.
    // Ce qui vient plus tard -- mains jouees, Reserves, profils d'avant-partie, lastMove,
    // mortSubiteRonde, chat, revanche, abandonPar, finMotif -- n'a rien a faire ici.
    function creationPartieBienFormee() {
      return request.resource.data.keys().hasOnly([
               'status', 'createdAt', 'blueUid', 'redUid',
               'blueOrderKeys', 'redOrderKeys', 'blueHand', 'redHand',
               'board', 'poisonedCells', 'turn', 'firstPlayer', 'gameOver',
               'bluePseudo', 'redPseudo',
               'defiMode', 'defiHerauts', 'defiOrdres', 'defiMainCommune',
               'tournoiId', 'matchKey', 'appariement', 'classique',
               'blueTrophees', 'redTrophees', 'blueTitre', 'redTitre',
               'blueBanniere', 'redBanniere', 'blueMedaillon', 'redMedaillon'
             ])
        && request.resource.data.keys().hasAll([
               'status', 'createdAt', 'blueUid', 'redUid',
               'blueOrderKeys', 'redOrderKeys', 'blueHand', 'redHand',
               'board', 'poisonedCells', 'turn', 'firstPlayer', 'gameOver'
             ])
        && request.resource.data.status == 'waiting-orders'
        && request.resource.data.createdAt == request.time
        && request.resource.data.blueUid is string
        && (request.resource.data.redUid == null || request.resource.data.redUid is string)
        // Une partie naît les mains vides, les Ordres non choisis, le plateau nu.
        && request.resource.data.blueOrderKeys == null
        && request.resource.data.redOrderKeys == null
        && request.resource.data.blueHand == null
        && request.resource.data.redHand == null
        && plateauNeuf()
        && request.resource.data.gameOver == false
        // Le premier joueur est tire une seule fois, et le tour part de lui : les quatre
        // creations posent turn et firstPlayer a la meme valeur. C'est aussi ce qui
        // interdit de naitre avec le tour deja dans son camp et l'autre en retard.
        && (request.resource.data.turn == 'blue' || request.resource.data.turn == 'red')
        && request.resource.data.turn == request.resource.data.firstPlayer
        && (!('bluePseudo' in request.resource.data) || partieNomBorne(request.resource.data.bluePseudo))
        && (!('redPseudo' in request.resource.data) || partieNomBorne(request.resource.data.redPseudo))
        && (!('blueTitre' in request.resource.data)
            || (request.resource.data.blueTitre is string && request.resource.data.blueTitre.size() <= 60))
        && (!('redTitre' in request.resource.data)
            || (request.resource.data.redTitre is string && request.resource.data.redTitre.size() <= 60))
        // La revanche recopie les trophees de la manche precedente avec ?? null : une
        // regle en « is int » seul aurait refuse toute revanche.
        && (!('blueTrophees' in request.resource.data) || request.resource.data.blueTrophees == null
            || partieEntier(request.resource.data.blueTrophees, 0, 100000))
        && (!('redTrophees' in request.resource.data) || request.resource.data.redTrophees == null
            || partieEntier(request.resource.data.redTrophees, 0, 100000))
        && (!('blueBanniere' in request.resource.data) || partieCleBornee(request.resource.data.blueBanniere))
        && (!('redBanniere' in request.resource.data) || partieCleBornee(request.resource.data.redBanniere))
        && (!('blueMedaillon' in request.resource.data) || partieCleBornee(request.resource.data.blueMedaillon))
        && (!('redMedaillon' in request.resource.data) || partieCleBornee(request.resource.data.redMedaillon))
        && (!('appariement' in request.resource.data) || request.resource.data.appariement is bool)
        && (!('classique' in request.resource.data) || request.resource.data.classique is bool)
        && (!('defiMode' in request.resource.data)
            || (request.resource.data.defiMode is string && request.resource.data.defiMode.size() <= 20))
        && (!('defiHerauts' in request.resource.data) || request.resource.data.defiHerauts is bool)
        && (!('defiOrdres' in request.resource.data) || request.resource.data.defiOrdres == null
            || deuxClesCourtes(request.resource.data.defiOrdres))
        && (!('defiMainCommune' in request.resource.data) || request.resource.data.defiMainCommune == null
            || (request.resource.data.defiMainCommune is list && request.resource.data.defiMainCommune.size() == 8))
        && (!('tournoiId' in request.resource.data)
            || (request.resource.data.tournoiId is string && request.resource.data.tournoiId.size() <= 40))
        && (!('matchKey' in request.resource.data)
            || (request.resource.data.matchKey is string && request.resource.data.matchKey.size() <= 8));
    }

    // Qui peut creer une partie. Trois createurs sur quatre sont l'un des deux camps :
    // le defi (Azur), l'appariement (Vermeil, Azur etant lu dans le salon) et la
    // revanche (l'Azur de la manche precedente, qui devient Vermeil). Le quatrieme est
    // un TIERS : les quarts d'un tournoi sont lances par n'importe quel client qui
    // constate huit inscrits, et les demies puis la finale sont ouvertes par celui qui
    // depose le dernier resultat du tour -- souvent un elimine. Exiger « le createur est
    // Azur ou Vermeil » aurait donc tue tout le tournoi en ligne ; on demande alors
    // qu'il soit inscrit au tournoi dont cette partie est un match.
    function createurLegitimeDePartie() {
      return request.resource.data.blueUid == request.auth.uid
        || request.resource.data.redUid == request.auth.uid
        || ('tournoiId' in request.resource.data
            && request.auth.uid in get(docTournoiPourPartie(request.resource.data.tournoiId)).data.joueurs);
    }

    // ---------- La preparation d'un camp ----------
    // Un camp ecrit SES cles, et seulement tant qu'il n'a pas envoye ses Ordres : sa
    // parure a l'entree (banniere et medaillon, ecriture separee parce que les champs du
    // salon sont bornes), puis en une seule fois ses Ordres, sa main, sa Reserve, le
    // profil que l'autre affichera dans le face-a-face, et sa declaration de rencontres
    // du jour. Ces cles se ferment ensuite : blueOrderKeys cesse d'etre null, et plus
    // personne ne rejoue une main, ne repose une Reserve, ni ne redeclare le compteur
    // anti-complices pour declasser une partie qu'il sent perdue.
    function clesPreparationAzur() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'blueOrderKeys', 'blueHand', 'blueReserve', 'blueParties', 'blueVictoires',
               'blueCombos', 'blueOrdreFavori', 'blueCombosParties', 'blueTournois',
               'blueTrophees', 'blueNiveau', 'blueDos', 'blueMedaillon', 'blueBanniere',
               'blueRencontres'
             ]);
    }
    function clesPreparationVermeil() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'redOrderKeys', 'redHand', 'redReserve', 'redParties', 'redVictoires',
               'redCombos', 'redOrdreFavori', 'redCombosParties', 'redTournois',
               'redTrophees', 'redNiveau', 'redDos', 'redMedaillon', 'redBanniere',
               'redRencontres'
             ]);
    }
    function preparationAzurBienFormee() {
      return (!('blueOrderKeys' in request.resource.data) || request.resource.data.blueOrderKeys == null
              || deuxClesCourtes(request.resource.data.blueOrderKeys))
        && (!('blueHand' in request.resource.data) || request.resource.data.blueHand == null
            || (request.resource.data.blueHand is list && request.resource.data.blueHand.size() <= 8))
        && (!('blueReserve' in request.resource.data)
            || (request.resource.data.blueReserve is list && request.resource.data.blueReserve.size() <= 2))
        && (!('blueParties' in request.resource.data) || partieEntier(request.resource.data.blueParties, 0, 1000000))
        && (!('blueVictoires' in request.resource.data) || partieEntier(request.resource.data.blueVictoires, 0, 1000000))
        && (!('blueCombosParties' in request.resource.data) || partieEntier(request.resource.data.blueCombosParties, 0, 1000000))
        && (!('blueCombos' in request.resource.data) || combosBornes(request.resource.data.blueCombos))
        && (!('blueOrdreFavori' in request.resource.data)
            || (request.resource.data.blueOrdreFavori is string && request.resource.data.blueOrdreFavori.size() <= 30))
        && (!('blueTournois' in request.resource.data) || partieEntier(request.resource.data.blueTournois, 0, 10000))
        && (!('blueTrophees' in request.resource.data) || request.resource.data.blueTrophees == null
            || partieEntier(request.resource.data.blueTrophees, 0, 100000))
        && (!('blueNiveau' in request.resource.data) || partieEntier(request.resource.data.blueNiveau, 1, 50))
        && (!('blueDos' in request.resource.data) || partieCleBornee(request.resource.data.blueDos))
        && (!('blueMedaillon' in request.resource.data) || partieCleBornee(request.resource.data.blueMedaillon))
        && (!('blueBanniere' in request.resource.data) || partieCleBornee(request.resource.data.blueBanniere))
        && (!('blueRencontres' in request.resource.data) || partieEntier(request.resource.data.blueRencontres, 0, 1000));
    }
    function preparationVermeilBienFormee() {
      return (!('redOrderKeys' in request.resource.data) || request.resource.data.redOrderKeys == null
              || deuxClesCourtes(request.resource.data.redOrderKeys))
        && (!('redHand' in request.resource.data) || request.resource.data.redHand == null
            || (request.resource.data.redHand is list && request.resource.data.redHand.size() <= 8))
        && (!('redReserve' in request.resource.data)
            || (request.resource.data.redReserve is list && request.resource.data.redReserve.size() <= 2))
        && (!('redParties' in request.resource.data) || partieEntier(request.resource.data.redParties, 0, 1000000))
        && (!('redVictoires' in request.resource.data) || partieEntier(request.resource.data.redVictoires, 0, 1000000))
        && (!('redCombosParties' in request.resource.data) || partieEntier(request.resource.data.redCombosParties, 0, 1000000))
        && (!('redCombos' in request.resource.data) || combosBornes(request.resource.data.redCombos))
        && (!('redOrdreFavori' in request.resource.data)
            || (request.resource.data.redOrdreFavori is string && request.resource.data.redOrdreFavori.size() <= 30))
        && (!('redTournois' in request.resource.data) || partieEntier(request.resource.data.redTournois, 0, 10000))
        && (!('redTrophees' in request.resource.data) || request.resource.data.redTrophees == null
            || partieEntier(request.resource.data.redTrophees, 0, 100000))
        && (!('redNiveau' in request.resource.data) || partieEntier(request.resource.data.redNiveau, 1, 50))
        && (!('redDos' in request.resource.data) || partieCleBornee(request.resource.data.redDos))
        && (!('redMedaillon' in request.resource.data) || partieCleBornee(request.resource.data.redMedaillon))
        && (!('redBanniere' in request.resource.data) || partieCleBornee(request.resource.data.redBanniere))
        && (!('redRencontres' in request.resource.data) || partieEntier(request.resource.data.redRencontres, 0, 1000));
    }

    // ---------- Un coup ----------
    // Huit cles au plus, et rien d'autre : ni un uid, ni un titre, ni un champ inconnu.
    // Le coup porte desormais l'heure du SERVEUR (lastMoveAt), et c'est elle qui rend le
    // forfait verifiable : sans horodatage impose, « l'adversaire n'a pas joue depuis
    // 225 secondes » n'etait qu'une horloge de navigateur. Le client doit donc l'ecrire,
    // et etre deploye AVANT la publication de ces regles.
    function clesDunCoup() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'board', 'blueHand', 'redHand', 'poisonedCells',
               'turn', 'gameOver', 'mortSubiteRonde', 'lastMove', 'lastMoveAt'
             ]);
    }
    // La partie a vraiment commence : les deux camps ont envoye leurs Ordres. Sans
    // cela, un « coup » pouvait tomber sur une partie qui n'avait pas debute.
    function partieCommencee() {
      return resource.data.blueOrderKeys != null && resource.data.redOrderKeys != null;
    }
    // Les bornes du coup. events a 200 et non 64 : un gros coup en produit jusqu'a une
    // soixantaine sur vingt cases (revelations de Scribes, chaines de captures, Onde,
    // combos emetteurs, Devoreuse, Maudits), et une borne trop basse aurait refuse un
    // coup legitime -- ce qui casse la partie pour les deux joueurs. 200 laisse trois
    // fois la marge tout en fermant le bourrage par la liste d'evenements.
    function coupBienForme() {
      return request.resource.data.board is list && request.resource.data.board.size() == 20
        && request.resource.data.poisonedCells is list && request.resource.data.poisonedCells.size() == 20
        && request.resource.data.blueHand is list && request.resource.data.blueHand.size() <= 8
        && request.resource.data.redHand is list && request.resource.data.redHand.size() <= 8
        && (request.resource.data.turn == 'blue' || request.resource.data.turn == 'red')
        && request.resource.data.gameOver is bool
        && partieEntier(request.resource.data.mortSubiteRonde, 0, 2)
        // L heure du serveur est un champ de PREMIER NIVEAU, lastMoveAt, et non une cle
        // de lastMove : « request.resource.data.X == request.time » est la forme que tout
        // ce fichier utilise deja (creeLe, envoyeeLe, depuis, date), la seule dont le
        // comportement soit certain. Un sentinelle serverTimestamp niche dans une carte
        // etait un pari, et le perdre aurait refuse TOUS les coups.
        && request.resource.data.lastMoveAt == request.time
        && request.resource.data.lastMove is map
        // Les cles de lastMove sont fermees elles aussi : « is map » seul laissait y
        // glisser un champ de bourrage d un megaoctet sur un coup par ailleurs legitime.
        && request.resource.data.lastMove.keys().hasOnly(['id', 'by', 'position', 'events', 'freshPoison'])
        && request.resource.data.lastMove.id is string && request.resource.data.lastMove.id.size() <= 40
        && partieEntier(request.resource.data.lastMove.position, 0, 19)
        && request.resource.data.lastMove.events is list && request.resource.data.lastMove.events.size() <= 200
        && request.resource.data.lastMove.freshPoison is list && request.resource.data.lastMove.freshPoison.size() <= 20;
    }
    // mortSubiteRonde n'existe pas a la creation : il arrive avec le premier coup.
    function rondeMortSubiteAvant() {
      return ('mortSubiteRonde' in resource.data) ? resource.data.mortSubiteRonde : 0;
    }
    // Le tour repasse en face. Il ne me revient que dans deux cas, les deux seuls que le
    // moteur produit : la partie se termine, ou une ronde de Mort Subite s'ouvre (et
    // alors mortSubiteRonde monte). Sans cette clause, enchainer les coups pendant le
    // tour d'en face suffisait a vider sa main tout seul.
    function tourRendu(monCamp) {
      return request.resource.data.turn != monCamp
        || request.resource.data.gameOver == true
        || request.resource.data.mortSubiteRonde > rondeMortSubiteAvant();
    }

    // ---------- La fin ----------
    // Deux cles, une seule fois, sur une partie pas encore scellee. Poser abandonPar,
    // c'est designer le camp FAUTIF. Le mien : je pars, ou mon propre client constate
    // que je n'ai pas joue. Celui d'en face : SEULEMENT s'il est vraiment reste
    // silencieux. Sans ce dernier cas, un adversaire disparu figeait la partie a jamais ;
    // sans le delai, une seule requete volait quinze trophees a un joueur en train de
    // reflechir. Le delai est celui du jeu, TURN_SECONDS * 2 + 15, soit 225 secondes :
    // deux tours pleins et la marge reseau. Les minuteurs du client partent tous d'un
    // instant POSTERIEUR a lastMove.at (ou a createdAt avant le premier coup), donc un
    // forfait legitime arrive toujours apres cette borne.
    function delaiInactivite() { return duration.value(225, 's'); }
    function silenceAssezLong() {
      return ('lastMoveAt' in resource.data)
        ? request.time >= resource.data.lastMoveAt + delaiInactivite()
        : request.time >= resource.data.createdAt + delaiInactivite();
    }
    function finBienFormee() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abandonPar', 'finMotif'])
        && (request.resource.data.abandonPar == 'blue' || request.resource.data.abandonPar == 'red')
        && (request.resource.data.finMotif == 'abandon' || request.resource.data.finMotif == 'forfait')
        && resource.data.gameOver == false
        && (!('abandonPar' in resource.data) || resource.data.abandonPar == null);
    }
    // On n'attend un camp que si c'est son tour, ou s'il n'a toujours pas envoye ses
    // Ordres : les deux seuls silences que le jeu constate, le garde-fou de jeu et le
    // forfait d'avant-match.
    function onAttendAzur() {
      return resource.data.turn == 'blue'
        || !('blueOrderKeys' in resource.data) || resource.data.blueOrderKeys == null;
    }
    function onAttendVermeil() {
      return resource.data.turn == 'red'
        || !('redOrderKeys' in resource.data) || resource.data.redOrderKeys == null;
    }

    // ---------- Le chat ----------
    // Une seule cle, une liste de soixante messages au plus : c'est la fenetre glissante
    // du client, devenue une regle. Ce que les regles ne savent PAS faire : mesurer la
    // longueur de chaque message, faute de boucle. Les 200 caracteres restent donc une
    // borne du client. Ce qui compte ici est ferme : la liste ne grandit plus sans fin,
    // et aucune autre cle ne peut servir de champ de bourrage.
    function chatBienForme() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chat'])
        && request.resource.data.chat is list
        && request.resource.data.chat.size() <= 60;
    }

    // ---------- La revanche ----------
    // Un vote a la fois, puis le code, et seulement quand les DEUX votes sont poses.
    // Avant, prochainCode s'ecrivait seul, vers une partie fabriquee de toutes pieces :
    // le client d'en face y basculait sans avoir rien vote.
    // La cle racine ET les cles internes : fermer seulement la racine laissait ecrire
    // revanche.bourrage dans l ecriture meme du vote, un megaoctet en une requete.
    function clesDeLaRevanche() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revanche'])
        && request.resource.data.revanche is map
        && request.resource.data.revanche.keys().hasOnly(['blue', 'red', 'prochainCode']);
    }
    function voteAzurAvant() {
      return 'revanche' in resource.data && 'blue' in resource.data.revanche
        && resource.data.revanche.blue == true;
    }
    function voteVermeilAvant() {
      return 'revanche' in resource.data && 'red' in resource.data.revanche
        && resource.data.revanche.red == true;
    }
    function sansCodeApres() { return !('prochainCode' in request.resource.data.revanche); }
    // Mon vote : ma cle passe a true, celle d'en face reste exactement ce qu'elle etait.
    function voteAzurSeul() {
      return request.resource.data.revanche.blue == true && sansCodeApres()
        && (voteVermeilAvant() ? request.resource.data.revanche.red == true
                               : !('red' in request.resource.data.revanche));
    }
    function voteVermeilSeul() {
      return request.resource.data.revanche.red == true && sansCodeApres()
        && (voteAzurAvant() ? request.resource.data.revanche.blue == true
                            : !('blue' in request.resource.data.revanche));
    }
    // Le code de la partie de revanche : les deux votes poses AVANT, aucun code encore,
    // les votes intacts, et la forme exacte d'un code de partie (l'alphabet de
    // makeGameCode, sans I, O, 0 ni 1).
    function codeDeRevanche() {
      return voteAzurAvant() && voteVermeilAvant()
        && !('prochainCode' in resource.data.revanche)
        && request.resource.data.revanche.blue == true
        && request.resource.data.revanche.red == true
        && request.resource.data.revanche.prochainCode is string
        && request.resource.data.revanche.prochainCode.matches('^[A-HJ-NP-Z2-9]{5}$');
    }

    match /games/{gameId} {
      // « get » et non « read » : le client n'interroge jamais la collection, il ouvre
      // une partie par son code. Ouvrir le listage, c'etait offrir l'annuaire de tous
      // les uid (et, par eux, les profils publics des amis).
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && creationPartieBienFormee()
        && createurLegitimeDePartie();

      allow update: if request.auth != null && (
        // Le siege Vermeil, pris par un TIERS : deux cles, la sienne et son nom. Un
        // troisieme champ, et toute l'ecriture est refusee (le client le sait).
        (resource.data.redUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redUid', 'redPseudo'])
          && request.resource.data.redUid == request.auth.uid
          && partieNomBorne(request.resource.data.redPseudo))

        // La preparation d'Azur, avant ses Ordres.
        || (resource.data.blueUid == request.auth.uid
            && resource.data.blueOrderKeys == null
            && clesPreparationAzur() && preparationAzurBienFormee())
        // La preparation de Vermeil, avant ses Ordres.
        || (resource.data.redUid == request.auth.uid
            && resource.data.redOrderKeys == null
            && clesPreparationVermeil() && preparationVermeilBienFormee())

        // Le coup d'Azur : c'est son tour, la partie a commence et n'est pas scellee.
        || (resource.data.blueUid == request.auth.uid
            && resource.data.turn == 'blue' && partieCommencee()
            && resource.data.gameOver == false && !('abandonPar' in resource.data)
            && clesDunCoup() && coupBienForme()
            && request.resource.data.lastMove.by == 'blue' && tourRendu('blue'))
        // Le coup de Vermeil.
        || (resource.data.redUid == request.auth.uid
            && resource.data.turn == 'red' && partieCommencee()
            && resource.data.gameOver == false && !('abandonPar' in resource.data)
            && clesDunCoup() && coupBienForme()
            && request.resource.data.lastMove.by == 'red' && tourRendu('red'))

        // La fin, posee par Azur : son propre depart, ou le silence constate de Vermeil.
        || (resource.data.blueUid == request.auth.uid && finBienFormee()
            && (request.resource.data.abandonPar == 'blue'
                || (request.resource.data.finMotif == 'forfait'
                    && onAttendVermeil() && silenceAssezLong())))
        // La fin, posee par Vermeil.
        || (resource.data.redUid == request.auth.uid && finBienFormee()
            && (request.resource.data.abandonPar == 'red'
                || (request.resource.data.finMotif == 'forfait'
                    && onAttendAzur() && silenceAssezLong())))

        // Le chat, par l'un ou l'autre camp.
        || ((resource.data.blueUid == request.auth.uid || resource.data.redUid == request.auth.uid)
            && chatBienForme())

        // La revanche : mon vote, puis le code une fois les deux votes poses.
        || (resource.data.blueUid == request.auth.uid && clesDeLaRevanche()
            && (voteAzurSeul() || codeDeRevanche()))
        || (resource.data.redUid == request.auth.uid && clesDeLaRevanche()
            && (voteVermeilSeul() || codeDeRevanche()))
      );

      allow delete: if false;
    }

    // ============================== TOURNOIS ==============================
    //
    // 03/09 : le document de tournoi etait un livre ouvert pour tout inscrit, et
    // n importe qui pouvait s inscrire a un tournoi en attente. De la, quatre coups :
    // se declarer champion et faire perdre leur mise aux sept autres, poser un
    // vainqueur sur un match ou l on ne joue pas, se mettre en tete de liste pour
    // usurper l organisateur, et reecrire la cagnotte.
    //
    // Desormais SIX intentions, chacune avec ses cles fermees :
    //   rejoindre   la liste devient exactement l ancienne PLUS moi, en dernier ;
    //   se retirer  exactement l ancienne MOINS moi ;
    //   completer   l organisateur seul, une seule fois, et le prix est pose au meme
    //               instant, a la valeur EXACTE que le nombre d humains commande ;
    //   lancer      huit inscrits, l arbre des quarts cree une fois, la grille etant
    //               exactement celle des sieges ;
    //   l arbre     un vainqueur pose par un JOUEUR de ce match, ou un signe de vie ;
    //   le sacre    champion egal au vainqueur de la finale, et rien d autre.
    //
    // Deux mots sur ce que ces regles ne font PAS.
    // 1. La mise et le prix vivent dans le stockage local du joueur (S8 de l audit) :
    //    ces regles empechent de FALSIFIER le document du tournoi, pas de tricher sur
    //    son propre solde de gemmes. Aucune illusion a se faire la-dessus.
    // 2. Le lancement n est PAS reserve a l organisateur, contrairement a ce qu on
    //    pourrait attendre : le client le declenche depuis n importe quel appareil qui
    //    constate huit inscrits, precisement pour ne dependre d aucun hote qui aurait
    //    ferme l application. Le reserver au premier siege aurait gele tout tournoi dont
    //    l organisateur est parti, avec huit mises deja payees. Il est donc reserve aux
    //    INSCRITS, et la grille qu il pose est verifiee siege par siege.
    //
    // Le document est desormais entierement epingle : chaque valeur qui s ecrit est soit
    // une constante, soit derivee de ce qui etait deja la. D ou l absence de bornes de
    // taille : aucune chaine libre n y entre plus. Il n y a ni champ de mise, ni pseudo,
    // ni code dans ce document -- le code est l identifiant, les pseudos se lisent dans
    // /users, et la mise n existe que localement.

    function tournoiEnAttente() { return resource.data.status == 'waiting'; }
    function tournoiCles(cles) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(cles); }
    function tournoiJeJoue(m) { return m.a == request.auth.uid || m.b == request.auth.uid; }
    // Un siege d Echo : le prefixe que rien d autre ne porte, et au plus six d entre eux
    // (huit sieges moins les deux humains qu il faut au minimum pour completer).
    function tournoiEstEcho(u) { return u is string && u.matches('^echo:[1-6]$'); }
    // Un horodatage pose A L INSTANT. Ces deux champs viennent de Date.now(), l horloge
    // du navigateur, et non du serveur : les borner a deux minutes de l heure du serveur
    // est ce qui empeche d antidater l ouverture d un match pour declarer un humain
    // forfait sur-le-champ. Deux minutes, et non une : une horloge de bureau derive, et
    // un lancement refuse pour cela aurait gele le tournoi. Il reste donc trois des cinq
    // minutes de silence a l humain visé, dans le pire cas. Le vrai remede serait un
    // serverTimestamp, mais le client soustrait ces valeurs a Date.now() pour afficher
    // son compte a rebours : ce sera une mission a part.
    function tournoiInstant(v) {
      return v is int
        && v >= request.time.toMillis() - 120000
        && v <= request.time.toMillis() + 120000;
    }
    // Cinq minutes sans le moindre signe de vie, exactement le critere du client :
    // le battement s il existe, sinon l ouverture du match.
    function tournoiSilenceEcho(m) {
      return ('vivantA' in m)
        ? request.time.toMillis() >= m.vivantA + 300000
        : ('ouvertA' in m) && request.time.toMillis() >= m.ouvertA + 300000;
    }

    // ---------- La creation ----------
    // Creer un tournoi, c est s y inscrire seul, salle en attente, arbre vide.
    function creationTournoiBienFormee() {
      return request.resource.data.keys().hasOnly(['createdAt', 'status', 'joueurs', 'matches', 'champion'])
        && request.resource.data.keys().hasAll(['createdAt', 'status', 'joueurs', 'matches', 'champion'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'waiting'
        && request.resource.data.joueurs == [request.auth.uid]
        && request.resource.data.matches.keys().size() == 0
        && request.resource.data.champion == null;
    }

    // ---------- Rejoindre et se retirer ----------
    // concat et removeAll rendent la liste au caractere pres : plus personne ne se
    // reordonne pour passer premier, ni ne retire un autre joueur en passant. C est ce
    // qui ferme l usurpation de l organisateur, qui n est pas un champ mais le premier
    // siege -- il ne change donc que si son titulaire se retire, ce qui est legitime.
    function tournoiRejoindre() {
      return tournoiCles(['joueurs']) && tournoiEnAttente()
        && !(request.auth.uid in resource.data.joueurs)
        && resource.data.joueurs.size() < 8
        && request.resource.data.joueurs == resource.data.joueurs.concat([request.auth.uid]);
    }
    // Pas de « je suis inscrit » a verifier : l egalite avec removeAll ne permet, par
    // construction, que le retrait de MON uid. Si je n y suis pas, elle exige la liste
    // inchangee -- une ecriture sans effet, qu il valait mieux accepter que refuser.
    function tournoiSeRetirer() {
      return tournoiCles(['joueurs']) && tournoiEnAttente()
        && request.resource.data.joueurs == resource.data.joueurs.removeAll([request.auth.uid]);
    }

    // ---------- Completer la salle avec des Echos ----------
    // L organisateur seul, une seule fois (le prix atteste que c est fait), et les six
    // formes possibles sont enumerees : pour N humains, huit moins N Echos nommes dans
    // l ordre, et le prix EXACT qui en decoule. Rien a arrondir dans la regle, donc rien
    // a discuter : douze gemmes et demie par humain, plafonnees a cent, et l XP au
    // prorata. C est l anti pompe a gemmes, ecrit une fois pour toutes.
    function tournoiCompleter() {
      return tournoiCles(['joueurs', 'prixGemmes', 'prixXp', 'humains']) && tournoiEnAttente()
        && resource.data.joueurs[0] == request.auth.uid
        && !('prixGemmes' in resource.data)
        && request.resource.data.humains == resource.data.joueurs.size()
        && (
               (request.resource.data.humains == 2
                  && request.resource.data.prixGemmes == 25
                  && request.resource.data.prixXp == 75
                  && request.resource.data.joueurs == resource.data.joueurs.concat(['echo:1', 'echo:2', 'echo:3', 'echo:4', 'echo:5', 'echo:6']))
             || (request.resource.data.humains == 3
                  && request.resource.data.prixGemmes == 38
                  && request.resource.data.prixXp == 113
                  && request.resource.data.joueurs == resource.data.joueurs.concat(['echo:1', 'echo:2', 'echo:3', 'echo:4', 'echo:5']))
             || (request.resource.data.humains == 4
                  && request.resource.data.prixGemmes == 50
                  && request.resource.data.prixXp == 150
                  && request.resource.data.joueurs == resource.data.joueurs.concat(['echo:1', 'echo:2', 'echo:3', 'echo:4']))
             || (request.resource.data.humains == 5
                  && request.resource.data.prixGemmes == 63
                  && request.resource.data.prixXp == 188
                  && request.resource.data.joueurs == resource.data.joueurs.concat(['echo:1', 'echo:2', 'echo:3']))
             || (request.resource.data.humains == 6
                  && request.resource.data.prixGemmes == 75
                  && request.resource.data.prixXp == 225
                  && request.resource.data.joueurs == resource.data.joueurs.concat(['echo:1', 'echo:2']))
             || (request.resource.data.humains == 7
                  && request.resource.data.prixGemmes == 88
                  && request.resource.data.prixXp == 263
                  && request.resource.data.joueurs == resource.data.joueurs.concat(['echo:1']))
           );
    }

    // ---------- Lancer les quarts ----------
    // La grille n est pas au choix de celui qui lance : les huit sieges donnent les
    // quatre matchs, dans l ordre. Un inscrit qui truquerait l arbre pour s offrir un
    // Echo au premier tour n a plus de prise.
    function tournoiQuartBienForme(m, a, b) {
      return m.keys().hasOnly(['a', 'b', 'gameId', 'vainqueur', 'ouvertA'])
        && m.a == a && m.b == b && m.vainqueur == null
        && (m.gameId == null || (m.gameId is string && m.gameId.size() <= 60))
        && (!('ouvertA' in m) || tournoiInstant(m.ouvertA));
    }
    function tournoiLancer() {
      return tournoiCles(['status', 'matches']) && tournoiEnAttente()
        && request.auth.uid in resource.data.joueurs
        && resource.data.joueurs.size() == 8
        && resource.data.matches.keys().size() == 0
        && request.resource.data.status == 'running'
        && request.resource.data.matches.keys().hasOnly(['qf0', 'qf1', 'qf2', 'qf3'])
        && request.resource.data.matches.keys().size() == 4
        && tournoiQuartBienForme(request.resource.data.matches.qf0, resource.data.joueurs[0], resource.data.joueurs[1])
        && tournoiQuartBienForme(request.resource.data.matches.qf1, resource.data.joueurs[2], resource.data.joueurs[3])
        && tournoiQuartBienForme(request.resource.data.matches.qf2, resource.data.joueurs[4], resource.data.joueurs[5])
        && tournoiQuartBienForme(request.resource.data.matches.qf3, resource.data.joueurs[6], resource.data.joueurs[7]);
    }

    // ---------- L arbre ----------
    // Un match ne bouge que de deux facons : il recoit son vainqueur, pose par l un de
    // ses DEUX joueurs et choisi parmi eux ; ou il recoit un signe de vie, par l un de
    // ses deux joueurs, sur un match d Echo qui n a pas de document de partie. Tout
    // autre match doit rester identique au caractere pres.
    function tournoiMatchIntactOuDecide(avant, apres) {
      return apres == avant
        || (apres.keys().hasOnly(['a', 'b', 'gameId', 'vainqueur', 'ouvertA', 'vivantA'])
            && apres.a == avant.a && apres.b == avant.b
            && apres.gameId == avant.gameId
            && avant.vainqueur == null
            // L ouverture d un match ne se reecrit jamais : elle date le silence.
            && (!('ouvertA' in apres) || (('ouvertA' in avant) && apres.ouvertA == avant.ouvertA))
            && (
                 // Le vainqueur, pose par l un des DEUX joueurs du match et choisi
                 // parmi eux : c est le cas de tous les matchs entre humains.
                 (tournoiJeJoue(avant)
                   && (apres.vainqueur == avant.a || apres.vainqueur == avant.b))
                 // Mon signe de vie sur mon propre match d Echo, horodate a l instant :
                 // c est lui qui me protege du forfait pendant que je reflechis.
                 || (tournoiJeJoue(avant) && apres.vainqueur == null
                     && tournoiInstant(apres.vivantA))
                 // Un match d Echo, sans document de partie, resolu par N IMPORTE QUEL
                 // inscrit -- et c est voulu : deux Echos se simulent a l identique sur
                 // tous les appareils, et face a un humain parti, ce sont les AUTRES qui
                 // constatent le forfait, sinon l arbre gelait pour les huit. Le
                 // vainqueur est alors forcement l ECHO : un tiers ne peut jamais faire
                 // gagner un humain un match qu il n a pas joue.
                 || (avant.gameId == null
                     && apres.vainqueur is string
                     && (apres.vainqueur == avant.a || apres.vainqueur == avant.b)
                     && tournoiEstEcho(apres.vainqueur)
                     && ((tournoiEstEcho(avant.a) && tournoiEstEcho(avant.b))
                         || tournoiSilenceEcho(avant)))
               ));
    }
    // Un match du tour suivant s ouvre sur les vainqueurs des deux matchs qui le
    // nourrissent, jamais sur deux joueurs choisis a la main.
    function tournoiNouveauMatch(m, a, b) {
      return m.keys().hasOnly(['a', 'b', 'gameId', 'vainqueur', 'ouvertA'])
        && m.a == a && m.b == b && m.vainqueur == null
        && a != null && b != null
        && (m.gameId == null || (m.gameId is string && m.gameId.size() <= 60))
        && (!('ouvertA' in m) || tournoiInstant(m.ouvertA));
    }
    function tournoiArbre() {
      return resource.data.status == 'running'
        && request.auth.uid in resource.data.joueurs
        && resource.data.matches.keys().hasAll(['qf0', 'qf1', 'qf2', 'qf3'])
        && request.resource.data.matches.keys().hasOnly(['qf0', 'qf1', 'qf2', 'qf3', 'sf0', 'sf1', 'f0'])
        && request.resource.data.matches.keys().hasAll(resource.data.matches.keys())
        && tournoiMatchIntactOuDecide(resource.data.matches.qf0, request.resource.data.matches.qf0)
        && tournoiMatchIntactOuDecide(resource.data.matches.qf1, request.resource.data.matches.qf1)
        && tournoiMatchIntactOuDecide(resource.data.matches.qf2, request.resource.data.matches.qf2)
        && tournoiMatchIntactOuDecide(resource.data.matches.qf3, request.resource.data.matches.qf3)
        && (!('sf0' in request.resource.data.matches)
            || ('sf0' in resource.data.matches
                ? tournoiMatchIntactOuDecide(resource.data.matches.sf0, request.resource.data.matches.sf0)
                : tournoiNouveauMatch(request.resource.data.matches.sf0,
                      request.resource.data.matches.qf0.vainqueur, request.resource.data.matches.qf1.vainqueur)))
        && (!('sf1' in request.resource.data.matches)
            || ('sf1' in resource.data.matches
                ? tournoiMatchIntactOuDecide(resource.data.matches.sf1, request.resource.data.matches.sf1)
                : tournoiNouveauMatch(request.resource.data.matches.sf1,
                      request.resource.data.matches.qf2.vainqueur, request.resource.data.matches.qf3.vainqueur)))
        && (!('f0' in request.resource.data.matches)
            || ('f0' in resource.data.matches
                ? tournoiMatchIntactOuDecide(resource.data.matches.f0, request.resource.data.matches.f0)
                : tournoiNouveauMatch(request.resource.data.matches.f0,
                      request.resource.data.matches.sf0.vainqueur, request.resource.data.matches.sf1.vainqueur)));
    }
    // Le sacre : champion vaut le vainqueur de la finale, et le tournoi se clot.
    function tournoiSacre() {
      return request.resource.data.status == 'done'
        && 'f0' in request.resource.data.matches
        && request.resource.data.matches.f0.vainqueur != null
        && request.resource.data.champion == request.resource.data.matches.f0.vainqueur;
    }

    match /tournaments/{tournoiId} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null && creationTournoiBienFormee();

      allow update: if request.auth != null && (
        tournoiRejoindre()
        || tournoiSeRetirer()
        || tournoiCompleter()
        || tournoiLancer()
        // Un resultat, ou un signe de vie : les matchs seuls.
        || (tournoiCles(['matches']) && tournoiArbre())
        // Le dernier resultat de la finale, qui porte le sacre dans la meme ecriture.
        || (tournoiCles(['matches', 'champion', 'status']) && tournoiArbre() && tournoiSacre())
      );

      allow delete: if false;
    }

    // Salle d'attente de l'appariement automatique. Un seul document ("lobby") où le
    // joueur en attente s'inscrit et où celui qui l'apparie annonce la partie créée.
    // Tout utilisateur connecté doit pouvoir l'écrire : c'est justement ainsi que deux
    // inconnus se trouvent. Le document ne contient aucune donnée sensible (deux
    // identifiants anonymes et un code de partie), et la transaction côté client
    // empêche deux joueurs d'être appariés au même adversaire.
    // À durcir en même temps que /games le jour d'un vrai lancement public : ici, un
    // client malveillant peut vider la salle d'attente ou s'y réinscrire en boucle.
    // Forme du salon : huit champs, tous bornes. Un seul non borne suffisait a y loger
    // ce qu'on voulait — et le client recopie waitingTitre et waitingPseudo dans le
    // document de partie, ou ils s afficheraient tels quels chez l adversaire.
    function salonBienForme() {
      return request.resource.data.keys().hasOnly([
               'waitingUid', 'waitingAt', 'waitingTrophees', 'waitingTitre', 'waitingPseudo',
               'matchedUid', 'matchedGameId', 'matchedAt'
             ])
        && (!('waitingUid' in request.resource.data) || request.resource.data.waitingUid == null
            || (request.resource.data.waitingUid is string && request.resource.data.waitingUid.size() <= 128))
        && (!('matchedUid' in request.resource.data) || request.resource.data.matchedUid == null
            || (request.resource.data.matchedUid is string && request.resource.data.matchedUid.size() <= 128))
        && (!('waitingPseudo' in request.resource.data) || request.resource.data.waitingPseudo == null
            || (request.resource.data.waitingPseudo is string && request.resource.data.waitingPseudo.size() <= 28))
        && (!('waitingTitre' in request.resource.data) || request.resource.data.waitingTitre == null
            || (request.resource.data.waitingTitre is string && request.resource.data.waitingTitre.size() <= 60))
        && (!('matchedGameId' in request.resource.data) || request.resource.data.matchedGameId == null
            || (request.resource.data.matchedGameId is string && request.resource.data.matchedGameId.size() <= 8))
        && (!('waitingTrophees' in request.resource.data) || request.resource.data.waitingTrophees == null
            || (request.resource.data.waitingTrophees is int
                && request.resource.data.waitingTrophees >= 0
                && request.resource.data.waitingTrophees <= 100000))
        && (!('waitingAt' in request.resource.data) || request.resource.data.waitingAt == null
            || request.resource.data.waitingAt is int)
        && (!('matchedAt' in request.resource.data) || request.resource.data.matchedAt == null
            || request.resource.data.matchedAt is int);
    }

    // DEUX documents nommes, et deux seulement : "lobby" pour le Classe,
    // "classique" pour la Partie classique (01/09). Le joker /{docId} laissait
    // creer autant de documents qu'on voulait dans cette collection ; la liste
    // fermee garde cette porte close tout en ouvrant la seconde file.
    // Deux documents et non deux champs dans le meme : c'est ce qui rend le
    // melange des files IMPOSSIBLE, pas seulement improbable. Un joueur en
    // file classique n'ecrit ni ne lit jamais le document du Classe.
    function fileConnue(f) { return f == 'lobby' || f == 'classique'; }

    // ---------- Le salon, 03/09 : trois intentions, et rien d'autre ----------
    //
    // Ce document n'avait qu'une garde : la place d'attente ne se prenait que pour soi.
    // Tout le reste etait libre, et deux attaques en vivaient.
    //
    // L'AIGUILLAGE (S1), la plus vicieuse de l'audit : n'importe qui ecoutait le salon,
    // voyait qui attendait, fabriquait une partie ou la victime etait Azur avec un
    // plateau deja joue et un abandon deja pose, puis annoncait CETTE partie-la. La
    // victime y entrait et perdait quinze trophees sans avoir joue un coup. Le client
    // verifiait bien qu'il etait Azur, mais rien de plus -- et l'attaquant le savait.
    // Desormais l'annonce et la partie sont jugees ENSEMBLE : getAfter relit la partie
    // visee telle qu'elle sera apres la transaction, et exige qu'elle oppose vraiment
    // celui qui attendait, en Azur, a celui qui apparie, en Vermeil. Avec la creation
    // contrainte de /games -- plateau vide, partie non finie -- la partie forgee n'a
    // plus ou naitre, et l'annonce qui la designerait n'a plus ou passer.
    //
    // LE SABOTAGE (S5) : effacer l'attente d'autrui etait permis, sciemment, parce que
    // c'est ce que fait l'appariement legitime. On ne le distingue plus par la
    // confiance mais par la PREUVE : effacer la place d'un autre n'est permis que dans
    // l'ecriture qui l'apparie vraiment. Vider la file en boucle n'est plus une
    // ecriture valide. Et la place ne se prend que si elle est libre, mienne, ou
    // abandonnee depuis plus d'une minute -- le meme seuil que le client.

    function docPartieDuSalon(c) { return /databases/$(database)/documents/games/$(c); }
    function salonCles(cles) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(cles); }
    function salonChange(cle) { return request.resource.data.diff(resource.data).affectedKeys().hasAny([cle]); }

    // Un horodatage du salon vient du NAVIGATEUR, pas du serveur : le client le compare
    // a son propre Date.now() pour juger une inscription perimee. On le borne donc de
    // facon ASYMETRIQUE, et c'est voulu :
    //  - serre vers l'avenir (une minute), parce qu'une valeur lointaine gelait la file
    //    pour toujours -- une attente qui n'expire jamais, et plus personne n'est
    //    apparie ;
    //  - large vers le passe (cinq minutes), parce qu'une valeur ancienne ne nuit qu'a
    //    celui qui l'ecrit : son inscription est aussitot tenue pour abandonnee, et le
    //    suivant lui prend sa place. Une horloge en retard ne doit pas priver un joueur
    //    du Classe.
    // Reste, assume : une horloge en AVANCE de plus d'une minute empeche d'entrer en
    // file. C'est rare, et le prix a payer pour fermer le squat perpetuel.
    function salonInstant(v) {
      return v is int
        && v <= request.time.toMillis() + 60000
        && v >= request.time.toMillis() - 300000;
    }

    // La place est-elle a prendre ? Libre, mienne, ou abandonnee depuis plus d'une
    // minute -- ATTENTE_PERIMEE_MS cote client, le meme seuil des deux cotes.
    function attenteAPrendre() {
      return !('waitingUid' in resource.data) || resource.data.waitingUid == null
        || resource.data.waitingUid == request.auth.uid
        || !('waitingAt' in resource.data) || resource.data.waitingAt == null
        || request.time.toMillis() >= resource.data.waitingAt + 60000;
    }
    // L'annonce qui m'etait adressee : la seule que je puisse effacer.
    function annonceAMoi() {
      return ('matchedUid' in resource.data) && resource.data.matchedUid == request.auth.uid;
    }
    function annonceEffacee() {
      return request.resource.data.matchedUid == null
        && request.resource.data.matchedGameId == null
        && request.resource.data.matchedAt == null;
    }

    // ---------- Intention 1 : je prends la place d'attente ----------
    // Mes champs d'affichage voyagent avec moi -- ce sont les MIENS, et personne
    // d'autre ne peut les ecrire, puisque cette intention exige que je devienne
    // waitingUid. L'annonce qui m'etait adressee s'efface au passage, jamais celle
    // d'un autre.
    function salonJeMInscris() {
      return salonCles(['waitingUid', 'waitingAt', 'waitingTrophees', 'waitingTitre',
                        'waitingPseudo', 'matchedUid', 'matchedGameId', 'matchedAt'])
        && request.resource.data.waitingUid == request.auth.uid
        && salonInstant(request.resource.data.waitingAt)
        && attenteAPrendre()
        && (!salonChange('matchedUid') || (annonceAMoi() && annonceEffacee()));
    }

    // ---------- Intention 2 : j'apparie celui qui attendait ----------
    // La seule ecriture qui ait le droit d'effacer la place d'un AUTRE, et elle doit le
    // prouver : la partie annoncee, relue apres la transaction qui la cree, oppose bien
    // celui qui attendait, en Azur, a moi, en Vermeil. Les champs d'affichage de la
    // victime ne sont pas dans la liste : celui qui apparie ne peut pas les reecrire au
    // passage pour la presenter sous un faux nom.
    function partieAnnonceeCoherente(code, azur) {
      let p = getAfter(docPartieDuSalon(code)).data;
      return p.blueUid == azur && p.redUid == request.auth.uid && p.appariement == true;
    }
    function salonJApparie() {
      return salonCles(['waitingUid', 'waitingAt', 'matchedUid', 'matchedGameId', 'matchedAt'])
        && ('waitingUid' in resource.data)
        && resource.data.waitingUid != null
        && resource.data.waitingUid != request.auth.uid
        && request.resource.data.waitingUid == null
        && request.resource.data.waitingAt == null
        && request.resource.data.matchedUid == resource.data.waitingUid
        && request.resource.data.matchedGameId is string
        && request.resource.data.matchedGameId.matches('^[A-HJ-NP-Z2-9]{5}$')
        && salonInstant(request.resource.data.matchedAt)
        && partieAnnonceeCoherente(request.resource.data.matchedGameId, resource.data.waitingUid);
    }

    // ---------- Intention 3 : je me retire ----------
    // Deux gestes du client passent par la : quitter la file, et effacer l'annonce une
    // fois entre dans la partie. Ce qui bouge s'efface, et seulement ce qui est a moi.
    function salonJeMeRetire() {
      return salonCles(['waitingUid', 'waitingAt', 'matchedUid', 'matchedGameId', 'matchedAt'])
        && (salonChange('waitingUid') || salonChange('matchedUid'))
        && (!salonChange('waitingUid')
            || (('waitingUid' in resource.data) && resource.data.waitingUid == request.auth.uid
                && request.resource.data.waitingUid == null
                && request.resource.data.waitingAt == null))
        && (!salonChange('matchedUid') || (annonceAMoi() && annonceEffacee()))
        // Rien ne bouge sans son chef de file : ni l'horodatage seul, ni le code seul.
        && (!salonChange('waitingAt') || salonChange('waitingUid'))
        && (!salonChange('matchedGameId') || salonChange('matchedUid'))
        && (!salonChange('matchedAt') || salonChange('matchedUid'));
    }

    match /matchmaking/{file} {
      allow read: if request.auth != null && fileConnue(file);

      // Le tout premier ecrit du document : je m'y inscris, et rien d'autre.
      allow create: if request.auth != null && fileConnue(file) && salonBienForme()
        && request.resource.data.waitingUid == request.auth.uid
        && salonInstant(request.resource.data.waitingAt);

      allow update: if request.auth != null && fileConnue(file) && salonBienForme()
        && (salonJeMInscris() || salonJApparie() || salonJeMeRetire());

      allow delete: if false;
    }

    // ============================== AMIS ==============================
    //
    // Un document par joueur, /users/{uid}, où uid est l'identifiant anonyme Firebase.
    // Il ne porte que le PROFIL PUBLIC (pseudo, code ami, dernière présence). Tout le
    // relationnel vit dans des sous-collections dont l'identifiant du document est l'uid
    // de l'AUTRE joueur :
    //   /users/{uid}/demandes/{deUid}      demande d'ami reçue par uid, envoyée par deUid
    //   /users/{uid}/amis/{amiUid}         lien d'amitié, écrit en double (chez les deux)
    //   /users/{uid}/invitations/{deUid}   défi (invitation à une partie) envoyé par l'ami deUid
    //   /users/{uid}/bloques/{autreUid}    joueurs dont uid ne veut plus rien recevoir
    // plus un index /codesAmi/{code} = { uid } pour retrouver un joueur par son numero,
    // et une collection /signalements, en écriture seule côté joueur.
    //
    // Pourquoi des sous-collections et pas des tableaux dans le profil ? Une demande
    // d'ami, c'est un INCONNU qui écrit chez vous. Avec un tableau, il faudrait lui
    // ouvrir « update » sur votre document et prouver champ par champ qu'il n'a rien
    // touché d'autre. Ici le document qu'il crée est séparé du vôtre, son nom EST son
    // uid, et la règle n'a qu'à vérifier deUid == request.auth.uid : il ne peut rien
    // écrire d'autre, nulle part. Les écritures à deux documents (accepter, retirer)
    // se font en batch côté client, et existsAfter() vérifie l'état APRÈS le batch.
    //
    // Deux conventions, partout :
    //  - aucun pseudo n'est recopié dans ces sous-collections : celui qui affiche un
    //    nom va le lire dans /users/{autreUid}, et le passe par le filtre côté client ;
    //  - tout horodatage doit valoir serverTimestamp() (== request.time), ce qui
    //    interdit d'antidater et fixe exactement le contenu de chaque document.

    function connecte() { return request.auth != null; }
    function moi() { return request.auth.uid; }

    function docUser(u)       { return /databases/$(database)/documents/users/$(u); }
    function docAmi(u, a)     { return /databases/$(database)/documents/users/$(u)/amis/$(a); }
    function docDemande(u, d) { return /databases/$(database)/documents/users/$(u)/demandes/$(d); }
    function docCode(c)       { return /databases/$(database)/documents/codesAmi/$(c); }
    function docBloque(u, b)  { return /databases/$(database)/documents/users/$(u)/bloques/$(b); }
    // Vrai si l'un des deux a bloqué l'autre : rien ne passe plus, dans aucun sens.
    function blocageEntre(a, b) { return exists(docBloque(a, b)) || exists(docBloque(b, a)); }
    function docPartie(c)     { return /databases/$(database)/documents/games/$(c); }

    // Pseudo : 14 caractères côté client ; size() compte en octets et les accents en
    // prennent deux, d'où 28. Le filtre des noms offensants reste côté client, chez
    // celui qui regarde : un client modifié peut écrire ce qu'il veut ici, personne
    // d'autre que lui ne le verra tel quel.
    function pseudoValide(p) { return p is string && p.size() <= 28; }

    // Identifiant du joueur : HUIT chiffres depuis le 03/09. Les pseudos ne sont pas
    // uniques ; deux CARNAGE peuvent coexister, et c'est ce numero qui les distingue.
    // Six chiffres, c'etait un espace d un million : un million de lectures livrait
    // l annuaire complet des uid, et par lui le profil de chacun. Huit chiffres rendent
    // le balayage cent fois plus cher. Cent fois, pas infini : la vraie reponse reste
    // une recherche par Cloud Function avec App Check, ou l enumeration ne passe plus
    // du tout. C'est une etape, pas la fin.
    function codeAmiValide(c) { return c is string && c.matches('^[0-9]{8}$'); }
    // Un numero de l ancien format, encore porte par les comptes d avant la bascule.
    function ancienCodeAmi(c) { return c is string && c.matches('^[0-9]{6}$'); }

    // Après le batch en cours, l'index /codesAmi/{code} doit exister et pointer vers
    // moi : un profil ne peut jamais annoncer un code qui ne mène pas à lui.
    function indexPointeVersMoi(code) {
      return getAfter(docCode(code)).data.uid == moi();
    }

    // Trophées et titre, montrés aux amis : un entier raisonnable et une courte chaîne.
    // Le client ne retient le titre que s'il est l'un des titres du jeu.
    function profilPublicValide() {
      return (!('trophees' in request.resource.data)
              || (request.resource.data.trophees is int && request.resource.data.trophees >= 0 && request.resource.data.trophees <= 100000))
          && (!('titre' in request.resource.data)
              || (request.resource.data.titre is string && request.resource.data.titre.size() <= 60))
          // Le profil que voit un adversaire : ses parties, ses victoires, ses combos.
          // Bornes larges mais fermees — un compteur libre serait un champ de texte
          // deguise, et la liste de combos un moyen d'entreposer n'importe quoi.
          && (!('parties' in request.resource.data)
              || (request.resource.data.parties is int && request.resource.data.parties >= 0 && request.resource.data.parties <= 1000000))
          && (!('victoires' in request.resource.data)
              || (request.resource.data.victoires is int && request.resource.data.victoires >= 0 && request.resource.data.victoires <= 1000000))
          && (!('combos' in request.resource.data)
              || (request.resource.data.combos is list && request.resource.data.combos.size() <= 3))
          // Les tournois en ligne remportes. Huit joueurs par tournoi : en gagner dix
          // mille supposerait quatre-vingt mille adversaires. La borne est large sans
          // etre ouverte, comme les autres.
          && (!('tournois' in request.resource.data)
              || (request.resource.data.tournois is int && request.resource.data.tournois >= 0 && request.resource.data.tournois <= 10000))
          // L'Ordre le plus joue : une cle courte, pas un champ de texte deguise. Le
          // client verifie de son cote qu'elle designe un Ordre qui existe ; ici on borne
          // seulement ce qu'un document peut contenir.
          && (!('ordreFavori' in request.resource.data)
              || (request.resource.data.ordreFavori is string && request.resource.data.ordreFavori.size() <= 30))
          // Les parties qui ouvrent droit a un titre : le denominateur de la jauge.
          && (!('combosParties' in request.resource.data)
              || (request.resource.data.combosParties is int && request.resource.data.combosParties >= 0 && request.resource.data.combosParties <= 1000000))
          // Le niveau de Commandant, montre aux amis : les niveaux du jeu vont de 1 a 50.
          && (!('niveau' in request.resource.data)
              || (request.resource.data.niveau is int && request.resource.data.niveau >= 1 && request.resource.data.niveau <= 50))
          // L'avatar du Commandant et sa bannière équipée : des clés courtes des
          // catalogues, pas des champs de texte déguisés. Le client vérifie de son
          // côté qu'elles désignent un médaillon et une bannière qui existent ;
          // ici on borne seulement ce qu'un document peut contenir.
          && (!('medaillon' in request.resource.data)
              || (request.resource.data.medaillon is string && request.resource.data.medaillon.size() <= 40))
          && (!('banniere' in request.resource.data)
              || (request.resource.data.banniere is string && request.resource.data.banniere.size() <= 40));
    }

    // Un horodatage de profil ne prend que l'heure du serveur, ou reste tel quel.
    // Ecrit deux fois plutot qu'une fonction a champ variable : la seconde forme
    // demanderait un acces par variable, syntaxe dont on ne veut pas dependre ici.
    function vuLeValide() {
      return !('vuLe' in request.resource.data)
        || request.resource.data.vuLe == request.time
        || (resource != null && 'vuLe' in resource.data && request.resource.data.vuLe == resource.data.vuLe);
    }
    function derniereDemandeValide() {
      return !('derniereDemande' in request.resource.data)
        || request.resource.data.derniereDemande == request.time
        || (resource != null && 'derniereDemande' in resource.data
            && request.resource.data.derniereDemande == resource.data.derniereDemande);
    }

    // Anti-rafale : au plus une demande d'ami toutes les 10 secondes par expéditeur.
    // Limite connue : un client modifié peut grouper plusieurs demandes dans un seul
    // batch, toutes jugées sur le même avant/après ; les règles ne comptent pas les
    // écritures d'un batch. Le vrai remède sera App Check et des comptes réels.
    // L'expéditeur doit, dans le MÊME batch que la demande, écrire
    // derniereDemande: serverTimestamp() sur son propre profil ; la règle compare la
    // valeur d'avant (get) à celle d'après (getAfter). Oublier cette écriture côté
    // client = demande refusée.
    function rafaleRespectee() {
      let avant = get(docUser(moi())).data;
      let apres = getAfter(docUser(moi())).data;
      return apres.derniereDemande == request.time
        && (!('derniereDemande' in avant)
            || avant.derniereDemande + duration.value(10, 's') <= request.time);
    }

    // ---------- Profil public ----------
    match /users/{uid} {
      // N'importe quel connecté peut lire UN profil (il faut bien afficher le pseudo
      // d'un ami ou d'un demandeur), jamais la collection entière : sans « list »,
      // impossible d'aspirer tous les pseudos et codes.
      allow get: if connecte();
      allow list: if false;

      // Création : soi-même seulement, champs fixés, code ami dont l'index est créé
      // dans la même transaction et pointe vers soi.
      allow create: if connecte() && moi() == uid
        && request.resource.data.keys().hasOnly(['pseudo', 'codeAmi', 'creeLe', 'vuLe', 'trophees', 'titre'])
        && pseudoValide(request.resource.data.pseudo)
        && profilPublicValide()
        && codeAmiValide(request.resource.data.codeAmi)
        && request.resource.data.creeLe == request.time
        && vuLeValide()
        && indexPointeVersMoi(request.resource.data.codeAmi);

      // Mise à jour : soi-même seulement. creeLe ne bouge jamais ; les horodatages ne
      // prennent que l'heure du serveur ; le code ami peut changer si l'index du
      // nouveau code pointe vers soi après le batch.
      allow update: if connecte() && moi() == uid
        // adoubementVu : la cérémonie de première ouverture a eu lieu. Un simple témoin,
        // que seul son propriétaire écrit et qui ne sert qu'à ne pas la rejouer.
        && request.resource.data.keys().hasOnly(['pseudo', 'codeAmi', 'creeLe', 'vuLe', 'derniereDemande', 'trophees', 'titre', 'adoubementVu', 'parties', 'victoires', 'combos', 'tournois', 'ordreFavori', 'combosParties', 'niveau', 'medaillon', 'banniere'])
        && pseudoValide(request.resource.data.pseudo)
        && profilPublicValide()
        // Le numero doit etre au nouveau format, SAUF s il n a pas bouge et qu il vient
        // de l ancien : sans cette tolerance, un joueur pas encore migre ne pourrait
        // plus rien ecrire dans son profil -- ni pseudo, ni trophees, ni parure.
        && (codeAmiValide(request.resource.data.codeAmi)
            || (request.resource.data.codeAmi == resource.data.codeAmi
                && ancienCodeAmi(resource.data.codeAmi)))
        && request.resource.data.creeLe == resource.data.creeLe
        // Le numero reste fige : en changer a volonte permettait de reserver des
        // identifiants sans jamais rendre les anciens. Une seule transition est ouverte,
        // celle de la bascule du 03/09 : un ancien numero a six chiffres se remplace par
        // un neuf a huit, dont l index doit pointer vers moi apres le lot. Elle se ferme
        // d elle-meme -- un code a huit chiffres n est plus un ancien.
        && (request.resource.data.codeAmi == resource.data.codeAmi
            || (ancienCodeAmi(resource.data.codeAmi)
                && codeAmiValide(request.resource.data.codeAmi)
                && indexPointeVersMoi(request.resource.data.codeAmi)))
        && vuLeValide()
        && derniereDemandeValide()
        // Le compteur anti-rafale ne s'efface pas en reecrivant le profil sans lui.
        && (!('derniereDemande' in resource.data) || 'derniereDemande' in request.resource.data);

      allow delete: if false;

      // ---------- Demandes d'ami reçues ----------
      // Le point dur : un INCONNU écrit chez moi. Il ne peut créer QUE le document qui
      // porte son propre uid, avec un seul champ horodaté. Il n'a accès à rien d'autre.
      match /demandes/{deUid} {
        allow list: if connecte() && moi() == uid;
        allow get: if connecte() && (moi() == uid || moi() == deUid);

        // « create, update » et non « create » seul : une demande deja posee se REECRIT.
        // Sans cela le client devait l'effacer d'abord, hors batch — et si l'anti-rafale
        // refusait ensuite le batch, la demande etait perdue des deux cotes.
        allow create, update: if connecte() && moi() == deUid
          && deUid != uid                        // pas de demande à soi-même
          && exists(docUser(uid))                // le destinataire existe
          && !exists(docAmi(uid, deUid))         // pas déjà amis
          && !blocageEntre(uid, deUid)           // aucun des deux n'a bloqué l'autre
          && request.resource.data.keys().hasOnly(['envoyeeLe'])
          && request.resource.data.envoyeeLe == request.time
          && rafaleRespectee();

        // Refus (destinataire) ou annulation (expéditeur). L'acceptation passe aussi par
        // ici : le destinataire supprime la demande dans le batch qui crée les deux liens.
        allow delete: if connecte() && (moi() == uid || moi() == deUid);
      }

      // ---------- Amis ----------
      // Un lien est écrit deux fois, chez chacun. Seul le destinataire d'une demande
      // peut les créer, dans UN batch qui contient les deux moitiés et supprime la
      // demande. Vu depuis la règle, ce batch produit deux créations :
      //  (a) chez moi  : /users/MOI/amis/LUI  — permis si la moitié miroir existe après ;
      //  (b) chez lui  : /users/LUI/amis/MOI  — permis seulement si LUI m'avait envoyé
      //      une demande (elle existe AVANT), si la moitié miroir existe APRÈS, et si
      //      la demande est supprimée dans ce même batch (sinon elle resservirait).
      // Personne ne peut donc s'inviter dans la liste d'un joueur qui ne l'a pas demandé.
      match /amis/{amiUid} {
        allow list: if connecte() && moi() == uid;
        allow get: if connecte() && (moi() == uid || moi() == amiUid);

        allow create: if connecte()
          && uid != amiUid
          && request.resource.data.keys().hasOnly(['depuis'])
          && request.resource.data.depuis == request.time
          && (
               (moi() == uid && existsAfter(docAmi(amiUid, uid)))
               ||
               (moi() == amiUid
                 && exists(docDemande(amiUid, uid))
                 && existsAfter(docAmi(amiUid, uid))
                 && !existsAfter(docDemande(amiUid, uid)))
             );

        allow update: if false;

        // Retirer un ami : chacun des deux peut effacer le lien, chez lui ET chez
        // l'autre (le client fait les deux suppressions dans un batch).
        allow delete: if connecte() && (moi() == uid || moi() == amiUid);
      }

      // ---------- Défis ----------
      // Réservé aux AMIS du destinataire, pour une partie que l'inviteur a réellement
      // créée (il y est Bleu) et qui attend encore son Rouge. Une seule invitation par
      // inviteur, puisque le nom du document est son uid ; une nouvelle partie remplace
      // la précédente.
      match /invitations/{deUid} {
        allow list: if connecte() && moi() == uid;
        allow get: if connecte() && (moi() == uid || moi() == deUid);

        allow create, update: if connecte() && moi() == deUid
          && deUid != uid
          && exists(docAmi(uid, deUid))
          && !blocageEntre(uid, deUid)
          && request.resource.data.keys().hasOnly(['code', 'envoyeeLe'])
          // Le code a la forme exacte d'un code de partie : le client de l'ami le met en
          // majuscules avant de rejoindre, un code forge en minuscules l'enverrait ailleurs.
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[A-HJ-NP-Z2-9]{5}$')
          && request.resource.data.envoyeeLe == request.time
          && get(docPartie(request.resource.data.code)).data.blueUid == moi()
          && get(docPartie(request.resource.data.code)).data.redUid == null;

        // Le destinataire l'efface une fois traitée, l'inviteur peut la retirer.
        allow delete: if connecte() && (moi() == uid || moi() == deUid);
      }

      // ---------- Blocages ----------
      // Liste privée, écrite et lue par son propriétaire seul. Un joueur bloqué ne peut
      // plus envoyer de demande ni de défi, et le bloqueur non plus vers lui (vérifié
      // par blocageEntre ci-dessus). Le client qui bloque efface aussi, dans le même
      // batch, l'amitié, les demandes et les défis en cours dans les deux sens. Le
      // bloqué reçoit un simple refus, indiscernable d'un identifiant inexistant.
      match /bloques/{bloqueUid} {
        allow read: if connecte() && moi() == uid;
        allow create: if connecte() && moi() == uid
          && uid != bloqueUid
          && request.resource.data.keys().hasOnly(['depuis'])
          && request.resource.data.depuis == request.time;
        allow update: if false;
        allow delete: if connecte() && moi() == uid;
      }

      // ---------- Presence ----------
      // Un seul document, un seul champ, l heure du serveur, et une seule question a
      // la lecture : es-tu dans MA liste d amis ?
      //
      // Elle vivait dans le profil public, ou n importe quel connecte pouvait la lire.
      // Rafraichie toutes les deux minutes, elle donnait bien plus qu une date : une
      // ecoute posee sur chaque profil rendait la presence en direct de toute la
      // population, a qui savait enumerer les numeros. Savoir quand quelqu un est
      // devant son telephone, sans etre son ami et sans qu il en sache rien, n a rien
      // a faire dans un profil public.
      //
      // Un refus de lecture est donc la situation NORMALE pour un adversaire, un
      // demandeur ou un joueur qu on vient d ajouter par son numero : le client
      // l attrape et n affiche simplement pas de presence.
      match /presence/{cle} {
        allow get: if connecte() && (moi() == uid || exists(docAmi(uid, moi())));
        allow list: if false;
        allow create, update: if connecte() && moi() == uid
          && cle == 'etat'
          && request.resource.data.keys().hasOnly(['vuLe'])
          && request.resource.data.vuLe == request.time;
        allow delete: if false;
      }
    }

    // ---------- Signalements ----------
    // Écriture seule côté joueur : on dépose, on ne relit jamais. L'auteur est l'uid
    // connecté (impossible d'en accuser un autre), la cible est un uid, le motif une
    // courte chaîne, la date celle du serveur. Le pseudo de la cible est recopié tel
    // que l'auteur le voyait, pour que l'éditeur sache ce qui a été signalé même si le
    // joueur en change ensuite.
    match /signalements/{id} {
      allow read: if false;
      allow create: if connecte()
        && request.resource.data.keys().hasOnly(['de', 'cible', 'motif', 'date', 'pseudoCible'])
        && request.resource.data.de == moi()
        && request.resource.data.cible is string
        && request.resource.data.cible != moi()
        && request.resource.data.motif is string && request.resource.data.motif.size() <= 40
        && request.resource.data.pseudoCible is string && request.resource.data.pseudoCible.size() <= 28
        && request.resource.data.date == request.time;
      allow update, delete: if false;
    }

    // ---------- Index des codes amis ----------
    // /codesAmi/{code} = { uid }. Lecture « get » seulement : pour trouver quelqu'un il
    // faut connaître son numero, on ne peut pas lister. Un code ne se crée que pour soi,
    // dans la transaction qui écrit aussi le profil (getAfter vérifie la cohérence), et
    // ne se modifie jamais : écrire sur un code déjà pris est un « update », refusé —
    // impossible d'écraser le code d'un autre.
    // ---------- Le Pantheon ----------
    // Le classement des 100 premiers Commandants tient dans UN document, reecrit par
    // le serveur (SDK admin, qui ignore ces regles). Le client ne peut que le LIRE :
    // une ecriture client permettrait de falsifier le classement entier, et une liste
    // n a aucun sens sur une collection qui ne contient qu un document.
    match /classement/{document} {
      allow get: if connecte();
      allow list: if false;
      allow write: if false;
    }

    match /codesAmi/{code} {
      allow get: if connecte();
      allow list: if false;
      allow create: if connecte()
        && codeAmiValide(code)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == moi()
        && getAfter(docUser(moi())).data.codeAmi == code;
      allow update: if false;
      allow delete: if connecte()
        && resource.data.uid == moi()
        && getAfter(docUser(moi())).data.codeAmi != code;
    }
  }
}
